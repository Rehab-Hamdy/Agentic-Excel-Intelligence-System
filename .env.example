# ==============================================================================
# Agentic Excel Intelligence System - Environment Variables Example
# ==============================================================================
# Copy this file to `.env` and fill in your API keys.
# You only need to configure ONE of the providers below.
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Google Gemini (Recommended)
# Get a key at: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
# GOOGLE_API_KEY=your_gemini_api_key_here
# LLM_PROVIDER=gemini
# MODEL_NAME=gemini-3.8-flash

# (Note: You can also use gemini_keys.txt for multiple API keys with auto-rotation)


# ------------------------------------------------------------------------------
# Option 2: OpenRouter (Great for Free Models)
# Get a key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# LLM_PROVIDER=openrouter
# MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free


# ------------------------------------------------------------------------------
# Option 3: Groq (Fast Inference)
# Get a key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_PROVIDER=groq
# MODEL_NAME=llama-3.3-70b-versatile
